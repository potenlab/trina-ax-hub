#!/usr/bin/env bash
# Trina AX — 이 PC를 회사 허브에 연결해요 (macOS, Linux)
#
#   연결:  curl -fsSL @@HUB_URL@@/install.sh | bash -s -- <연결 코드>
#   해제:  curl -fsSL @@HUB_URL@@/install.sh | bash -s -- --uninstall
#
# 하는 일
#   1. 연결 코드가 아직 쓸 수 있는지 허브에 먼저 물어봐요 (코드는 쓰지 않아요). 안 되면 여기서 멈춰요.
#   2. Claude Code가 없으면 공식 설치 스크립트(https://claude.ai/install.sh)로 설치해요.
#   3. 연결 코드를 이 PC 전용 토큰으로 바꿔요. 토큰은 화면에 나오지 않아요.
#   4. Claude Code 사용자 설정(~/.claude/settings.json)을 백업한 뒤, 있던 값은 그대로 두고 아래만 더해요.
#        env.*                                        허브가 이 사람의 방식에 맞춰 알려 주는 값만 (아래 두 가지 중 하나)
#        extraKnownMarketplaces["@@MARKETPLACE@@"]               회사 스킬 마켓플레이스 (자동 업데이트)
#        enabledPlugins["@@PLUGIN@@"]                  회사 스킬 플러그인
#   5. 회사 파일 MCP 서버 "@@MCP_NAME@@"를 등록하고 (claude mcp add --scope user) 회사 스킬을 설치해요.
#      스킬을 받는 데 최대 3분 걸려요. 진행 상황을 10초마다 한 줄씩 보여 주고, 3분이 지나면 멈춰요 (연결은 그대로
#      유효하고, 스킬은 다음에 Claude Code를 켤 때 받아요).
#   --uninstall 은 이 스크립트가 더한 것만 되돌려요 (바꾸기 전 값이 있었다면 그 값으로).
#
# 사람마다 Claude를 쓰는 방식이 둘 중 하나예요. 어느 쪽인지는 허브가 정하고, 이 스크립트는 허브가 준 env 값을
# 그대로 적을 뿐이에요.
#   구독 (subscription)   AI 사용은 본인 Claude 구독으로 해요. 사용량만 회사 허브에 기록돼요.
#                         ANTHROPIC_* 는 건드리지 않아요 (본인 로그인을 덮어쓰면 안 돼서요). 대신 Claude Code의
#                         OpenTelemetry 내보내기(CLAUDE_CODE_ENABLE_TELEMETRY, OTEL_*)를 허브로 켜요.
#                         처음이면 claude 를 실행하면 브라우저에서 Claude 로그인이 열려요.
#   회사 키 (company_key) AI 사용료는 회사 계정으로 나가요. env.ANTHROPIC_BASE_URL, env.ANTHROPIC_AUTH_TOKEN 이
#                         회사 허브를 가리켜서 모델 요청이 허브를 거쳐요. 허브에 회사 API 키가 아직 없으면 연결은 되지만
#                         Claude가 답하지 못해요. 끝에 노란 경고로 알려요 (종료 코드는 0).
# 다른 방식으로 바뀐 뒤 다시 실행하면, 전에 더한 값 중 필요 없어진 것은 지우고 원래 값이 있었다면 되돌려요.
#
# 옵션: --name <이 PC 이름>   허브의 "내 PC" 목록에 보일 이름 (기본: 컴퓨터 이름)
# 환경 변수 (시험용): TRINA_SYNC_TIMEOUT_SECONDS (스킬 받기 제한, 기본 180), TRINA_SYNC_GRACE_SECONDS (제한 뒤 기다리는 시간,
#   기본 20), TRINA_PROGRESS_SECONDS (진행 줄 간격, 기본 10), NO_COLOR / FORCE_COLOR (색)
set -euo pipefail

HUB_URL='@@HUB_URL@@'
MARKETPLACE='@@MARKETPLACE@@'
PLUGIN='@@PLUGIN@@'
MCP_NAME='@@MCP_NAME@@'
TOKEN_PREFIX='@@TOKEN_PREFIX@@'
SCRIPT_VERSION='@@VERSION@@'

# ---------------------------------------------------------------------------------------------------------------
# output

say()  { printf '%s\n' "$*"; }
info() { printf '  · %s\n' "$*"; }
warn() { printf '  ! %s\n' "$*" >&2; }
die()  { printf '\n✗ %s\n' "$*" >&2; exit 1; }
# yellow on a terminal (not when NO_COLOR is set or the output is a file); FORCE_COLOR turns it on for a pipe
YELLOW=''; RESET=''
if [ -z "${NO_COLOR:-}" ] && { [ -t 1 ] || [ -n "${FORCE_COLOR:-}" ]; }; then YELLOW=$'\033[33m'; RESET=$'\033[0m'; fi
# hide anything that looks like a token before showing tool output
redact() { sed -E "s/${TOKEN_PREFIX}[A-Za-z0-9_-]+/${TOKEN_PREFIX}***/g"; }

usage() {
  cat <<EOF
Trina AX PC 연결 (스크립트 ${SCRIPT_VERSION})

  연결:  curl -fsSL ${HUB_URL}/install.sh | bash -s -- <연결 코드>
  해제:  curl -fsSL ${HUB_URL}/install.sh | bash -s -- --uninstall

  --name <이름>   허브에 보일 이 PC의 이름
EOF
}

# ---------------------------------------------------------------------------------------------------------------
# arguments and environment

MODE=install
CODE="${TRINA_CODE:-}"
DEVICE_NAME=''
while [ $# -gt 0 ]; do
  case "$1" in
    --uninstall|uninstall) MODE=uninstall ;;
    --name) [ $# -ge 2 ] || die "--name 다음에 이름을 적어 주세요."; DEVICE_NAME="$2"; shift ;;
    --name=*) DEVICE_NAME="${1#--name=}" ;;
    -h|--help) usage; exit 0 ;;
    -*) die "모르는 옵션이에요: $1 (도움말: --help)" ;;
    *) CODE="$1" ;;
  esac
  shift
done

case "$(uname -s)" in
  Darwin) OS=macos ;;
  Linux) OS=linux ;;
  *) die "이 스크립트는 macOS와 Linux용이에요. Windows에서는 PowerShell 명령을 써 주세요." ;;
esac

CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
SETTINGS="$CONFIG_DIR/settings.json"
STATE="$CONFIG_DIR/trina-ax.json"

WORK="$(mktemp -d "${TMPDIR:-/tmp}/trina-ax.XXXXXX")"
chmod 700 "$WORK"
cleanup() { rm -rf "$WORK"; rm -f "$SETTINGS.trina-tmp.$$" "$STATE.trina-tmp.$$"; }
trap cleanup EXIT

# ---------------------------------------------------------------------------------------------------------------
# JSON helper. Claude Code's settings.json is read, merged and written by a small program: on macOS with JavaScript
# for Automation (/usr/bin/osascript, always present), on Linux with python3 or node. Inputs are passed in TRINA_*
# environment variables, never as arguments, so the token never shows up in a process list (the env keys to set and
# the keys we manage come from the hub as JSON in TRINA_ENV and TRINA_ENV_OWNED). Results go to a file.

write_js_helper() {
  cat >"$WORK/settings.js" <<'JS'
var IS_NODE = typeof process !== 'undefined' && !!(process.versions && process.versions.node);
var ENV = null;
function env(k) {
  if (IS_NODE) return process.env[k] || '';
  if (!ENV) ENV = ObjC.deepUnwrap($.NSProcessInfo.processInfo.environment) || {};
  return ENV[k] == null ? '' : String(ENV[k]);
}
function fail(code) { throw new Error('TRINA_E_' + code); }
function readText(p) {
  if (!p) return null;
  if (IS_NODE) {
    var fs = require('fs');
    try { return fs.readFileSync(p, 'utf8'); } catch (e) { if (e && e.code === 'ENOENT') return null; fail('READ'); }
  }
  if (!$.NSFileManager.defaultManager.fileExistsAtPath(p)) return null;
  var s = ObjC.unwrap($.NSString.stringWithContentsOfFileEncodingError(p, $.NSUTF8StringEncoding, null));
  if (typeof s !== 'string') fail('READ');
  return s;
}
function writeText(p, text) {
  if (IS_NODE) { require('fs').writeFileSync(p, text, { mode: 384 }); return; }
  if (!$(text).writeToFileAtomicallyEncodingError(p, false, $.NSUTF8StringEncoding, null)) fail('WRITE');
}
function isObj(v) { return v !== null && typeof v === 'object' && !Array.isArray(v); }
function has(o, k) { return Object.prototype.hasOwnProperty.call(o, k); }
function isEmpty(o) { for (var k in o) if (has(o, k)) return false; return true; }
function parseDoc(text, what) {
  if (text === null || /^\s*$/.test(text)) return {};
  if (text.charCodeAt(0) === 0xFEFF) text = text.slice(1);
  var v;
  try { v = JSON.parse(text); } catch (e) { fail('PARSE_' + what); }
  if (!isObj(v)) fail('SHAPE_' + what);
  return v;
}
function readState() {
  try { var t = readText(env('TRINA_STATE')); var v = t ? JSON.parse(t) : null; return isObj(v) ? v : null; } catch (e) { return null; }
}
function dump(v) { return JSON.stringify(v, null, 2) + '\n'; }
function oneLine(v) { return (typeof v === 'string' ? v : JSON.stringify(v)).replace(/[\r\n]+/g, ' '); }

// installs before the generic env handling always set these two (state files without setKeys)
var LEGACY_KEYS = ['ANTHROPIC_BASE_URL', 'ANTHROPIC_AUTH_TOKEN'];
var CONTAINERS = ['env', 'extraKnownMarketplaces', 'enabledPlugins'];

// The hub decides the environment: TRINA_ENV is the JSON object of env keys to set, TRINA_ENV_OWNED the JSON array
// of every key either mode may set.
function jsonVar(k, wantArray) {
  var v;
  try { v = JSON.parse(env(k)); } catch (e) { fail('PARSE_RESPONSE'); }
  if (wantArray ? !Array.isArray(v) : !isObj(v)) fail('PARSE_RESPONSE');
  return v;
}

// The device token in our marketplace entry's Authorization header (set in both modes), and the entry's URL.
function ourMarketplace(s, name, prefix) {
  var m = isObj(s.extraKnownMarketplaces) && has(s.extraKnownMarketplaces, name) ? s.extraKnownMarketplaces[name] : null;
  var src = m && isObj(m.source) ? m.source : null;
  var h = src && isObj(src.headers) ? src.headers.Authorization : null;
  return {
    token: typeof h === 'string' && h.indexOf('Bearer ' + prefix) === 0 ? h.slice(7) : '',
    url: src && typeof src.url === 'string' ? src.url : ''
  };
}

function restore(o, k, previous) { if (has(previous, k)) o[k] = previous[k]; else delete o[k]; }

/** This hub's device token from settings.env: ANTHROPIC_AUTH_TOKEN (company-key mode) or the OTLP header
 *  (subscription mode), only when the matching address is this hub. '' when none. */
function envToken(s, hub, prefix) {
  var e = isObj(s.env) ? s.env : null;
  if (!e) return '';
  var tok = e.ANTHROPIC_AUTH_TOKEN;
  if (typeof tok === 'string' && tok.indexOf(prefix) === 0 && e.ANTHROPIC_BASE_URL === hub) return tok;
  var h = e.OTEL_EXPORTER_OTLP_HEADERS, ep = e.OTEL_EXPORTER_OTLP_LOGS_ENDPOINT;
  var m = typeof h === 'string' ? /^Authorization=Bearer (\S+)$/.exec(h) : null;
  if (m && m[1].indexOf(prefix) === 0 && typeof ep === 'string' && ep.indexOf(hub + '/') === 0) return m[1];
  return '';
}

function install() {
  var s = parseDoc(readText(env('TRINA_SETTINGS')), 'SETTINGS');
  var state = readState();
  var hub = env('TRINA_HUB'), token = env('TRINA_TOKEN'), prefix = env('TRINA_PREFIX');
  var name = env('TRINA_MARKETPLACE'), plugin = env('TRINA_PLUGIN');
  var toSet = jsonVar('TRINA_ENV', false), owned = jsonVar('TRINA_ENV_OWNED', true);
  var keys = Object.keys(toSet);
  var i, k;
  for (i = 0; i < keys.length; i++) if (typeof toSet[keys[i]] !== 'string') fail('PARSE_RESPONSE');
  for (i = 0; i < CONTAINERS.length; i++) {
    var c = s[CONTAINERS[i]];
    if (c !== undefined && c !== null && !isObj(c)) fail('SHAPE_SETTINGS');
  }
  var e = isObj(s.env) ? s.env : null;
  var old = ourMarketplace(s, name, prefix);
  var envTok = e && typeof e.ANTHROPIC_AUTH_TOKEN === 'string' ? e.ANTHROPIC_AUTH_TOKEN : '';
  var legacyOurs = envTok.indexOf(prefix) === 0;
  var oursBefore = legacyOurs || old.token !== '';
  var managed = owned.map(String);
  for (i = 0; i < keys.length; i++) if (managed.indexOf(keys[i]) < 0) managed.push(keys[i]);
  var previous, created, setBefore;
  if (state && isObj(state.previous) && isObj(state.previous.env) && Array.isArray(state.created)) {
    previous = state.previous; created = state.created; // keep what was there before the very first install
    setBefore = Array.isArray(state.setKeys) ? state.setKeys : LEGACY_KEYS;
  } else {
    previous = { env: {} }; created = [];
    for (i = 0; i < CONTAINERS.length; i++) if (!isObj(s[CONTAINERS[i]])) created.push(CONTAINERS[i]);
    setBefore = legacyOurs ? LEGACY_KEYS : [];
    if (e && !oursBefore) for (i = 0; i < managed.length; i++) if (has(e, managed[i])) previous.env[managed[i]] = e[managed[i]];
  }
  // the old token of this same hub is revoked after the switch (never sent anywhere else)
  var revoke = old.token !== '' && old.token !== token && old.url.indexOf(hub + '/') === 0 ? old.token : '';
  for (i = 0; i < CONTAINERS.length; i++) if (!isObj(s[CONTAINERS[i]])) s[CONTAINERS[i]] = {};
  // keys the other mode set before: back to what the person had, or gone
  for (i = 0; i < setBefore.length; i++) {
    k = String(setBefore[i]);
    if (!has(toSet, k)) restore(s.env, k, previous.env);
  }
  for (i = 0; i < keys.length; i++) s.env[keys[i]] = toSet[keys[i]];
  s.extraKnownMarketplaces[name] = {
    source: { source: 'url', url: env('TRINA_MARKETPLACE_URL'), headers: { Authorization: 'Bearer ' + token } },
    autoUpdate: true
  };
  s.enabledPlugins[plugin] = true;
  writeText(env('TRINA_SETTINGS_OUT'), dump(s));
  writeText(env('TRINA_STATE_OUT'), dump({
    product: 'trina-ax', hubUrl: hub, marketplace: name, plugin: plugin, installedAt: env('TRINA_NOW'),
    created: created, previous: previous, setKeys: keys
  }));
  return revoke;
}

function uninstall() {
  var s = parseDoc(readText(env('TRINA_SETTINGS')), 'SETTINGS');
  var state = readState();
  var hub = env('TRINA_HUB'), prefix = env('TRINA_PREFIX');
  var name = env('TRINA_MARKETPLACE'), plugin = env('TRINA_PLUGIN');
  var previous = state && isObj(state.previous) && isObj(state.previous.env) ? state.previous.env : {};
  var created = state && Array.isArray(state.created) ? state.created : [];
  var old = ourMarketplace(s, name, prefix);
  var revoke = old.token !== '' && old.url.indexOf(hub + '/') === 0 ? old.token : '';
  // `claude plugin marketplace remove` runs before this and drops the marketplace entry, so also find the token
  // where the modes put it: the relay token, or the telemetry header
  if (revoke === '') revoke = envToken(s, hub, prefix);
  var changed = false, i, k;
  if (isObj(s.env)) {
    if (state && Array.isArray(state.setKeys)) {
      for (i = 0; i < state.setKeys.length; i++) {
        k = String(state.setKeys[i]);
        if (has(s.env, k) || has(previous, k)) { restore(s.env, k, previous); changed = true; }
      }
    } else {
      // state files from before the modes: the two ANTHROPIC_* keys, recognised by the token prefix and the hub URL
      var hubs = [hub];
      if (state && typeof state.hubUrl === 'string') hubs.push(state.hubUrl);
      var tok = s.env.ANTHROPIC_AUTH_TOKEN, base = s.env.ANTHROPIC_BASE_URL;
      var oursTok = typeof tok === 'string' && tok.indexOf(prefix) === 0;
      var oursBase = typeof base === 'string' && hubs.indexOf(base) >= 0;
      if (revoke === '' && oursTok && base === hub) revoke = tok;
      if (oursTok) { restore(s.env, 'ANTHROPIC_AUTH_TOKEN', previous); changed = true; }
      if (oursBase) { restore(s.env, 'ANTHROPIC_BASE_URL', previous); changed = true; }
    }
  }
  if (isObj(s.extraKnownMarketplaces) && has(s.extraKnownMarketplaces, name)) { delete s.extraKnownMarketplaces[name]; changed = true; }
  if (isObj(s.enabledPlugins) && has(s.enabledPlugins, plugin)) { delete s.enabledPlugins[plugin]; changed = true; }
  for (i = 0; i < created.length; i++) {
    k = String(created[i]);
    if (CONTAINERS.indexOf(k) >= 0 && isObj(s[k]) && isEmpty(s[k])) { delete s[k]; changed = true; }
  }
  if (changed) writeText(env('TRINA_SETTINGS_OUT'), dump(s));
  return revoke + '\n' + (changed ? 'changed' : 'unchanged');
}

function get() {
  var doc;
  try { doc = JSON.parse(env('TRINA_JSON')); } catch (e) { fail('PARSE_RESPONSE'); }
  var fields = env('TRINA_FIELDS').split(','), out = [], i, j;
  for (i = 0; i < fields.length; i++) {
    var raw = fields[i].charAt(0) === '@'; // @name: the value as one line of JSON (objects and arrays stay whole)
    var v = doc, parts = (raw ? fields[i].slice(1) : fields[i]).split('.');
    for (j = 0; j < parts.length && v !== null && v !== undefined; j++) v = isObj(v) ? v[parts[j]] : undefined;
    if (raw) out.push(JSON.stringify(v === undefined ? null : v));
    else if (Array.isArray(v)) { for (j = 0; j < v.length; j++) out.push(oneLine(v[j])); }
    else out.push(v === null || v === undefined ? '' : oneLine(v));
  }
  return out.join('\n');
}

function body() {
  var device = Array.from ? Array.from(env('TRINA_DEVICE')).slice(0, 80).join('') : env('TRINA_DEVICE').slice(0, 80);
  return JSON.stringify({ code: env('TRINA_CODE'), deviceName: device, os: env('TRINA_OS') });
}

function main() {
  var op = env('TRINA_OP'), out;
  if (op === 'install') out = install();
  else if (op === 'uninstall') out = uninstall();
  else if (op === 'get') out = get();
  else if (op === 'body') out = body();
  else fail('OP');
  writeText(env('TRINA_RESULT'), out + '\n');
  return '';
}
function run() { return main(); } // osascript calls run()
if (IS_NODE) {
  try { main(); } catch (e) { process.stderr.write(String((e && e.message) || e) + '\n'); process.exit(1); }
}
JS
}

write_py_helper() {
  cat >"$WORK/settings.py" <<'PY'
import json, os, sys

# installs before the generic env handling always set these two (state files without setKeys)
LEGACY_KEYS = ['ANTHROPIC_BASE_URL', 'ANTHROPIC_AUTH_TOKEN']
CONTAINERS = ['env', 'extraKnownMarketplaces', 'enabledPlugins']

class Fail(Exception):
    pass

def env(k):
    return os.environ.get(k, '')

def fail(code):
    raise Fail('TRINA_E_' + code)

def read_text(p):
    if not p:
        return None
    try:
        with open(p, 'r', encoding='utf-8') as f:
            return f.read()
    except FileNotFoundError:
        return None
    except (OSError, UnicodeDecodeError):
        fail('READ')

def write_text(p, text):
    fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w', encoding='utf-8', newline='\n') as f:
        f.write(text)

def is_obj(v):
    return isinstance(v, dict)

def parse_doc(text, what):
    if text is None or not text.strip():
        return {}
    if text.startswith('﻿'):
        text = text[1:]
    try:
        v = json.loads(text)
    except ValueError:
        fail('PARSE_' + what)
    if not is_obj(v):
        fail('SHAPE_' + what)
    return v

def read_state():
    try:
        t = read_text(env('TRINA_STATE'))
        v = json.loads(t) if t else None
    except (Fail, ValueError):
        return None
    return v if is_obj(v) else None

def dump(v):
    return json.dumps(v, indent=2, ensure_ascii=False) + '\n'

def one_line(v):
    s = v if isinstance(v, str) else json.dumps(v, ensure_ascii=False)
    return s.replace('\r', ' ').replace('\n', ' ')

# The hub decides the environment: TRINA_ENV is the JSON object of env keys to set, TRINA_ENV_OWNED the JSON array of
# every key either mode may set.
def json_var(k, want_list):
    try:
        v = json.loads(env(k))
    except ValueError:
        fail('PARSE_RESPONSE')
    if not (isinstance(v, list) if want_list else is_obj(v)):
        fail('PARSE_RESPONSE')
    return v

# The device token in our marketplace entry's Authorization header (set in both modes), and the entry's URL.
def our_marketplace(s, name, prefix):
    m = s['extraKnownMarketplaces'].get(name) if is_obj(s.get('extraKnownMarketplaces')) else None
    src = m.get('source') if is_obj(m) and is_obj(m.get('source')) else None
    h = src['headers'].get('Authorization') if src is not None and is_obj(src.get('headers')) else None
    url = src.get('url') if src is not None and isinstance(src.get('url'), str) else ''
    return (h[7:] if isinstance(h, str) and h.startswith('Bearer ' + prefix) else ''), url

def restore(o, k, previous):
    if k in previous:
        o[k] = previous[k]
    else:
        o.pop(k, None)

def install():
    s = parse_doc(read_text(env('TRINA_SETTINGS')), 'SETTINGS')
    state = read_state()
    hub, token, prefix = env('TRINA_HUB'), env('TRINA_TOKEN'), env('TRINA_PREFIX')
    name, plugin = env('TRINA_MARKETPLACE'), env('TRINA_PLUGIN')
    to_set, owned = json_var('TRINA_ENV', False), [str(k) for k in json_var('TRINA_ENV_OWNED', True)]
    keys = list(to_set.keys())
    if any(not isinstance(to_set[k], str) for k in keys):
        fail('PARSE_RESPONSE')
    for c in CONTAINERS:
        if s.get(c) is not None and not is_obj(s.get(c)):
            fail('SHAPE_SETTINGS')
    e = s['env'] if is_obj(s.get('env')) else None
    old_token, old_url = our_marketplace(s, name, prefix)
    env_tok = e.get('ANTHROPIC_AUTH_TOKEN') if e is not None and isinstance(e.get('ANTHROPIC_AUTH_TOKEN'), str) else ''
    legacy_ours = env_tok.startswith(prefix)
    ours_before = legacy_ours or old_token != ''
    managed = owned + [k for k in keys if k not in owned]
    if state and is_obj(state.get('previous')) and is_obj(state['previous'].get('env')) and isinstance(state.get('created'), list):
        previous, created = state['previous'], state['created']  # keep what was there before the very first install
        set_before = state['setKeys'] if isinstance(state.get('setKeys'), list) else LEGACY_KEYS
    else:
        previous, created = {'env': {}}, [c for c in CONTAINERS if not is_obj(s.get(c))]
        set_before = LEGACY_KEYS if legacy_ours else []
        if e is not None and not ours_before:
            for k in managed:
                if k in e:
                    previous['env'][k] = e[k]
    # the old token of this same hub is revoked after the switch (never sent anywhere else)
    revoke = old_token if old_token != '' and old_token != token and old_url.startswith(hub + '/') else ''
    for c in CONTAINERS:
        if not is_obj(s.get(c)):
            s[c] = {}
    # keys the other mode set before: back to what the person had, or gone
    for k in set_before:
        if str(k) not in to_set:
            restore(s['env'], str(k), previous['env'])
    for k in keys:
        s['env'][k] = to_set[k]
    s['extraKnownMarketplaces'][name] = {
        'source': {'source': 'url', 'url': env('TRINA_MARKETPLACE_URL'), 'headers': {'Authorization': 'Bearer ' + token}},
        'autoUpdate': True,
    }
    s['enabledPlugins'][plugin] = True
    write_text(env('TRINA_SETTINGS_OUT'), dump(s))
    write_text(env('TRINA_STATE_OUT'), dump({
        'product': 'trina-ax', 'hubUrl': hub, 'marketplace': name, 'plugin': plugin, 'installedAt': env('TRINA_NOW'),
        'created': created, 'previous': previous, 'setKeys': keys,
    }))
    return revoke

def env_token(s, hub, prefix):
    e = s.get('env') if is_obj(s.get('env')) else None
    if not e:
        return ''
    tok = e.get('ANTHROPIC_AUTH_TOKEN')
    if isinstance(tok, str) and tok.startswith(prefix) and e.get('ANTHROPIC_BASE_URL') == hub:
        return tok
    h, ep = e.get('OTEL_EXPORTER_OTLP_HEADERS'), e.get('OTEL_EXPORTER_OTLP_LOGS_ENDPOINT')
    if isinstance(h, str) and h.startswith('Authorization=Bearer ') and ' ' not in h[len('Authorization=Bearer '):]:
        t = h[len('Authorization=Bearer '):]
        if t.startswith(prefix) and isinstance(ep, str) and ep.startswith(hub + '/'):
            return t
    return ''

def uninstall():
    s = parse_doc(read_text(env('TRINA_SETTINGS')), 'SETTINGS')
    state = read_state()
    hub, prefix = env('TRINA_HUB'), env('TRINA_PREFIX')
    name, plugin = env('TRINA_MARKETPLACE'), env('TRINA_PLUGIN')
    prev = state.get('previous') if state else None
    previous = prev['env'] if is_obj(prev) and is_obj(prev.get('env')) else {}
    created = state['created'] if state and isinstance(state.get('created'), list) else []
    old_token, old_url = our_marketplace(s, name, prefix)
    revoke = old_token if old_token != '' and old_url.startswith(hub + '/') else ''
    # `claude plugin marketplace remove` runs before this and drops the marketplace entry, so also find the token
    # where the modes put it: the relay token, or the telemetry header
    if revoke == '':
        revoke = env_token(s, hub, prefix)
    changed = False
    if is_obj(s.get('env')):
        if state and isinstance(state.get('setKeys'), list):
            for k in state['setKeys']:
                k = str(k)
                if k in s['env'] or k in previous:
                    restore(s['env'], k, previous)
                    changed = True
        else:
            # state files from before the modes: the two ANTHROPIC_* keys, recognised by the token prefix and the hub URL
            hubs = [hub] + ([state['hubUrl']] if state and isinstance(state.get('hubUrl'), str) else [])
            tok, base = s['env'].get('ANTHROPIC_AUTH_TOKEN'), s['env'].get('ANTHROPIC_BASE_URL')
            ours_tok = isinstance(tok, str) and tok.startswith(prefix)
            ours_base = isinstance(base, str) and base in hubs
            if revoke == '' and ours_tok and base == hub:
                revoke = tok
            if ours_tok:
                restore(s['env'], 'ANTHROPIC_AUTH_TOKEN', previous)
                changed = True
            if ours_base:
                restore(s['env'], 'ANTHROPIC_BASE_URL', previous)
                changed = True
    if is_obj(s.get('extraKnownMarketplaces')) and name in s['extraKnownMarketplaces']:
        del s['extraKnownMarketplaces'][name]
        changed = True
    if is_obj(s.get('enabledPlugins')) and plugin in s['enabledPlugins']:
        del s['enabledPlugins'][plugin]
        changed = True
    for k in created:
        if k in CONTAINERS and is_obj(s.get(k)) and not s[k]:
            del s[k]
            changed = True
    if changed:
        write_text(env('TRINA_SETTINGS_OUT'), dump(s))
    return revoke + '\n' + ('changed' if changed else 'unchanged')

def get():
    try:
        doc = json.loads(env('TRINA_JSON'))
    except ValueError:
        fail('PARSE_RESPONSE')
    out = []
    for field in env('TRINA_FIELDS').split(','):
        raw = field.startswith('@')  # @name: the value as one line of JSON (objects and arrays stay whole)
        v = doc
        for part in (field[1:] if raw else field).split('.'):
            v = v.get(part) if is_obj(v) else None
        if raw:
            out.append(json.dumps(v, ensure_ascii=False, separators=(',', ':')))
        elif isinstance(v, list):
            out.extend(one_line(x) for x in v)
        else:
            out.append('' if v is None else one_line(v))
    return '\n'.join(out)

def body():
    # a host name that is not valid UTF-8 must not stop the install
    device = env('TRINA_DEVICE').encode('utf-8', 'surrogateescape').decode('utf-8', 'replace')[:80]
    return json.dumps({'code': env('TRINA_CODE'), 'deviceName': device, 'os': env('TRINA_OS')}, ensure_ascii=False)

def main():
    ops = {'install': install, 'uninstall': uninstall, 'get': get, 'body': body}
    op = ops.get(env('TRINA_OP'))
    if op is None:
        fail('OP')
    write_text(env('TRINA_RESULT'), op() + '\n')

try:
    main()
except Fail as e:
    sys.stderr.write(str(e) + '\n')
    sys.exit(1)
PY
}

pick_json_engine() {
  ENGINE="${TRINA_JSON_ENGINE:-}"
  if [ -z "$ENGINE" ]; then
    if [ "$OS" = macos ] && [ -x /usr/bin/osascript ]; then ENGINE=osascript
    elif command -v python3 >/dev/null 2>&1; then ENGINE=python3
    elif command -v node >/dev/null 2>&1; then ENGINE=node
    else die "설정 파일을 고치려면 python3 또는 node가 필요해요. 둘 중 하나를 설치한 뒤 다시 실행해 주세요."
    fi
  fi
  case "$ENGINE" in
    osascript) [ -x /usr/bin/osascript ] || die "osascript가 없어요." ; write_js_helper ;;
    node) command -v node >/dev/null 2>&1 || die "node가 없어요." ; write_js_helper ;;
    python3) command -v python3 >/dev/null 2>&1 || die "python3가 없어요." ; write_py_helper ;;
    *) die "TRINA_JSON_ENGINE은 osascript, python3, node 중 하나여야 해요." ;;
  esac
}

# json_op <op>: runs the helper with the TRINA_* variables already exported; the result is in "$WORK/result"
json_op() {
  local rc=0
  : >"$WORK/result"
  case "$ENGINE" in
    osascript) TRINA_OP="$1" TRINA_RESULT="$WORK/result" /usr/bin/osascript -l JavaScript "$WORK/settings.js" >/dev/null 2>"$WORK/json.err" || rc=$? ;;
    node)      TRINA_OP="$1" TRINA_RESULT="$WORK/result" node "$WORK/settings.js" >/dev/null 2>"$WORK/json.err" || rc=$? ;;
    python3)   TRINA_OP="$1" TRINA_RESULT="$WORK/result" python3 -I "$WORK/settings.py" >/dev/null 2>"$WORK/json.err" || rc=$? ;;
  esac
  if [ "$rc" -ne 0 ]; then
    JSON_ERROR="$(grep -o 'TRINA_E_[A-Z_]*' "$WORK/json.err" | head -n 1 || true)"
    [ -n "$JSON_ERROR" ] || JSON_ERROR="TRINA_E_ENGINE"
    return 1
  fi
  return 0
}

json_error_message() {
  case "$JSON_ERROR" in
    TRINA_E_PARSE_SETTINGS) printf '%s' "$SETTINGS 파일이 올바른 JSON이 아니에요. 파일을 고친 뒤 다시 실행해 주세요. 아무것도 바꾸지 않았어요." ;;
    TRINA_E_SHAPE_SETTINGS) printf '%s' "$SETTINGS 파일의 모양이 예상과 달라요 (env, extraKnownMarketplaces, enabledPlugins는 객체여야 해요). 아무것도 바꾸지 않았어요." ;;
    TRINA_E_READ) printf '%s' "$SETTINGS 파일을 읽지 못했어요 (UTF-8 텍스트인지, 읽기 권한이 있는지 확인해 주세요)." ;;
    TRINA_E_WRITE) printf '%s' "$CONFIG_DIR 폴더에 쓰지 못했어요. 권한을 확인해 주세요." ;;
    TRINA_E_PARSE_RESPONSE) printf '%s' "허브의 응답을 읽지 못했어요. 주소(${HUB_URL})가 맞는지 확인해 주세요." ;;
    *) printf '%s' "설정 도우미($ENGINE)가 실패했어요: $(head -c 300 "$WORK/json.err" | redact)" ;;
  esac
}

# read_fields <json> <field,field,...>: one value per line in "$WORK/result"
read_fields() {
  TRINA_JSON="$1" TRINA_FIELDS="$2" json_op get
}

# ---------------------------------------------------------------------------------------------------------------
# Claude Code

find_claude() {
  CLAUDE_BIN="$(command -v claude 2>/dev/null || true)"
  if [ -z "$CLAUDE_BIN" ] && [ -x "$HOME/.local/bin/claude" ]; then CLAUDE_BIN="$HOME/.local/bin/claude"; fi
}

install_claude() {
  find_claude
  if [ -n "$CLAUDE_BIN" ]; then info "Claude Code가 이미 있어요: $CLAUDE_BIN"; return; fi
  say "Claude Code를 설치해요 (공식 설치 스크립트). 보통 1~2분, 느린 인터넷이면 더 걸려요…"
  curl -fsSL https://claude.ai/install.sh | bash || die "Claude Code 설치에 실패했어요. https://code.claude.com 의 안내대로 설치한 뒤 다시 실행해 주세요."
  export PATH="$HOME/.local/bin:$PATH"
  find_claude
  [ -n "$CLAUDE_BIN" ] || die "Claude Code를 설치했지만 찾지 못했어요. 새 터미널을 열고 다시 실행해 주세요."
  info "Claude Code를 설치했어요: $CLAUDE_BIN"
}

# claude_quiet <args…>: runs claude, keeps its output (redacted) in "$WORK/claude.out" instead of the terminal
claude_quiet() {
  local rc=0
  "$CLAUDE_BIN" "$@" >"$WORK/claude.raw" 2>&1 </dev/null || rc=$?
  redact <"$WORK/claude.raw" >"$WORK/claude.out"
  rm -f "$WORK/claude.raw"
  return "$rc"
}
claude_said() { tail -n 3 "$WORK/claude.out" | tr '\n' ' ' | head -c 300; }

plugin_installed() {
  claude_quiet plugin list --json && grep -q "\"$PLUGIN\"" "$WORK/claude.out"
}

# claude_logged_in: success when Claude Code has a login (`claude auth status --json` exits 0 and does not say
# "loggedIn": false). A failing command (an older Claude Code, say) counts as not logged in.
claude_logged_in() {
  claude_quiet auth status --json || return 1
  ! grep -Eq '"loggedIn"[[:space:]]*:[[:space:]]*false' "$WORK/claude.out"
}

# sync_plugins: the one local-only Claude Code session (`claude -p /cost` makes no model request) that lets Claude Code
# register the marketplace from settings.json, with its auth header, and download the plugin. It can take minutes, so it
# runs in the background while this prints a progress line every few seconds. Claude Code gives up by itself after
# TRINA_SYNC_TIMEOUT_SECONDS (180); if it is still running a little later it is stopped here. Sets SYNC_SECONDS and
# SYNC_TIMED_OUT (1 = it did not finish in time). Its output is kept (redacted) in "$WORK/claude.out" as claude_quiet does.
sync_plugins() {
  local limit="${TRINA_SYNC_TIMEOUT_SECONDS:-180}" grace="${TRINA_SYNC_GRACE_SECONDS:-20}" every="${TRINA_PROGRESS_SECONDS:-10}"
  local pid next
  case "$limit$grace$every" in *[!0-9]*) limit=180; grace=20; every=10 ;; esac
  [ "$every" -ge 1 ] && [ "$limit" -ge 1 ] || { limit=180; every=10; }
  SYNC_TIMED_OUT=0
  SECONDS=0
  next="$every"
  ( cd "$WORK" || exit 1
    exec env CLAUDE_CODE_SYNC_PLUGIN_INSTALL=1 CLAUDE_CODE_SYNC_PLUGIN_INSTALL_TIMEOUT_MS=$((limit * 1000)) \
      "$CLAUDE_BIN" -p /cost --no-session-persistence --setting-sources user >"$WORK/claude.raw" 2>&1 </dev/null ) &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    sleep 1
    kill -0 "$pid" 2>/dev/null || break
    if [ "$SECONDS" -ge "$next" ]; then say "    … ${SECONDS}초 지났어요"; next=$((next + every)); fi
    if [ "$SECONDS" -ge $((limit + grace)) ]; then
      kill "$pid" 2>/dev/null || true
      sleep 1
      kill -9 "$pid" 2>/dev/null || true
      SYNC_TIMED_OUT=1
      break
    fi
  done
  wait "$pid" || true
  SYNC_SECONDS="$SECONDS"
  if [ "$SYNC_SECONDS" -ge "$limit" ]; then SYNC_TIMED_OUT=1; fi
  redact <"$WORK/claude.raw" >"$WORK/claude.out" 2>/dev/null || : >"$WORK/claude.out"
  rm -f "$WORK/claude.raw"
} 2>/dev/null # (bash would otherwise announce the background session it had to stop; nothing here writes to stderr on purpose)

# ---------------------------------------------------------------------------------------------------------------
# settings.json

backup_settings() {
  BACKUP=''
  [ -f "$SETTINGS" ] || return 0
  BACKUP="$SETTINGS.trina-backup-$(date +%Y%m%d-%H%M%S)"
  cp -p "$SETTINGS" "$BACKUP"
  chmod 600 "$BACKUP"
}

# replace "$1" with "$2" atomically; a symlinked settings.json (dotfiles) is written through, not replaced
put_file() {
  local target="$1" tmp="$2"
  chmod 600 "$tmp"
  if [ -L "$target" ]; then cat "$tmp" >"$target"; rm -f "$tmp"; else mv -f "$tmp" "$target"; fi
}

# ---------------------------------------------------------------------------------------------------------------
# hub

# post_json <path> <body file>: POSTs the file to the hub; sets HTTP_STATUS and HTTP_BODY. Dies when the hub is not reachable.
post_json() {
  local resp
  resp="$(curl -sS --connect-timeout 15 --max-time 60 -X POST \
    -H 'content-type: application/json; charset=utf-8' -H 'accept: application/json' \
    --data-binary @"$2" -w '\n%{http_code}' "$HUB_URL$1" 2>"$WORK/curl.err")" \
    || die "허브(${HUB_URL})에 연결하지 못했어요. 인터넷 연결과 주소를 확인해 주세요. ($(head -c 200 "$WORK/curl.err"))"
  HTTP_STATUS="${resp##*$'\n'}"
  HTTP_BODY="${resp%$'\n'*}"
}

# hub_message <json> <fallback>: the hub's Korean error message, or the fallback
hub_message() {
  local msg=''
  if read_fields "$1" 'error.message'; then msg="$(head -n 1 "$WORK/result")"; fi
  [ -n "$msg" ] || msg="$2"
  printf '%s' "$msg"
}

# check_code: asks the hub whether $CODE can still be used, without using it up. This runs before Claude Code is
# downloaded, so a mistyped, used or expired code stops here and not after minutes of waiting. Only a clear "no" stops
# the install; anything unexpected (an old hub, a proxy in between) is left to the real exchange in enroll.
check_code() {
  printf '{"code":"%s"}' "$CODE" >"$WORK/check.json"
  post_json /api/enroll/check "$WORK/check.json"
  case "$HTTP_STATUS" in
    200) ;;
    400|429) die "연결 코드를 확인하지 못했어요: $(hub_message "$HTTP_BODY" "허브가 HTTP $HTTP_STATUS 로 답했어요.") 아무것도 바꾸지 않았어요." ;;
  esac
}

# enroll: trades $CODE for a device token; sets TOKEN, HUB, MCP_URL, MARKETPLACE_URL, USER_NAME, COMPANY, SKILLS_READY,
# ACCESS_MODE (subscription | company_key), LOGIN_HINT, MODEL_NOTICE (why Claude cannot answer yet, or empty), ENV_JSON
# (the settings env to set) and ENV_OWNED_JSON
enroll() {
  local device resp status json
  device="$DEVICE_NAME"
  if [ -z "$device" ]; then
    if [ "$OS" = macos ]; then device="$(scutil --get ComputerName 2>/dev/null || true)"; fi
    [ -n "$device" ] || device="$(hostname 2>/dev/null || true)"
  fi
  device="$(printf '%s' "$device" | tr -d '\000-\037')"
  TRINA_CODE="$CODE" TRINA_DEVICE="$device" TRINA_OS="$OS" json_op body || die "$(json_error_message)"
  post_json /api/enroll "$WORK/result"
  status="$HTTP_STATUS"
  json="$HTTP_BODY"
  if [ "$status" != 200 ]; then
    die "연결 코드를 확인하지 못했어요: $(hub_message "$json" "허브가 HTTP $status 로 답했어요.")"
  fi
  read_fields "$json" 'token,hubUrl,mcpUrl,marketplaceUrl,user.name,companyName,skillsReady,mode,loginHint,modelNotice,@env,@envOwned' || die "$(json_error_message)"
  {
    IFS= read -r TOKEN; IFS= read -r HUB; IFS= read -r MCP_URL; IFS= read -r MARKETPLACE_URL
    IFS= read -r USER_NAME; IFS= read -r COMPANY; IFS= read -r SKILLS_READY
    IFS= read -r ACCESS_MODE; IFS= read -r LOGIN_HINT; IFS= read -r MODEL_NOTICE; IFS= read -r ENV_JSON; IFS= read -r ENV_OWNED_JSON
  } <"$WORK/result" || true
  case "$TOKEN" in "$TOKEN_PREFIX"?*) ;; *) die "허브의 응답에 토큰이 없어요. 관리자에게 알려 주세요." ;; esac
  [ -n "$HUB" ] && [ -n "$MCP_URL" ] && [ -n "$MARKETPLACE_URL" ] || die "허브의 응답이 모자라요. 관리자에게 알려 주세요."
  case "$ACCESS_MODE" in subscription|company_key) ;; *) die "허브의 응답이 모자라요. 관리자에게 알려 주세요." ;; esac
  case "$ENV_JSON" in '{'*'}') ;; *) die "허브의 응답이 모자라요. 관리자에게 알려 주세요." ;; esac
  case "$ENV_OWNED_JSON" in '['*']') ;; *) die "허브의 응답이 모자라요. 관리자에게 알려 주세요." ;; esac
  [ -n "$LOGIN_HINT" ] || LOGIN_HINT='터미널에서 claude 를 실행하면 브라우저에서 Claude 로그인이 열려요. 회사 Claude 계정으로 로그인해 주세요.'
  NOTICES=''
  if read_fields "$json" 'notices'; then NOTICES="$(cat "$WORK/result")"; fi
}

# revoke <token>: tells the hub this token is no longer used (best effort; the token goes in a header via stdin)
revoke() {
  [ -n "$1" ] || return 0
  printf 'header = "Authorization: Bearer %s"\n' "$1" |
    curl -sS -o /dev/null --connect-timeout 10 --max-time 20 -X POST -K - "$HUB_URL/api/unenroll" 2>/dev/null || true
}

# ---------------------------------------------------------------------------------------------------------------
# install

do_install() {
  say "Trina AX: 이 PC를 회사 허브(${HUB_URL})에 연결해요."
  pick_json_engine

  if [ -z "$CODE" ]; then
    if (exec </dev/tty) 2>/dev/null; then
      printf '연결 코드를 입력하세요 (예: ABCD-EFGH-JKLM): ' >/dev/tty
      IFS= read -r CODE </dev/tty || true
    else
      die "연결 코드가 필요해요: curl -fsSL ${HUB_URL}/install.sh | bash -s -- <연결 코드>"
    fi
  fi
  CODE="$(printf '%s' "$CODE" | tr -d '[:space:]')"
  case "$CODE" in ''|*[!A-Za-z0-9-]*) die "연결 코드는 영문과 숫자예요 (예: ABCD-EFGH-JKLM). 다시 확인해 주세요." ;; esac

  # the code first: Claude Code is only downloaded for a code that still works
  check_code
  install_claude
  enroll
  info "${USER_NAME:-사용자} 님 (${COMPANY:-회사}) 으로 연결해요."

  mkdir -p "$CONFIG_DIR"
  backup_settings
  export TRINA_SETTINGS="$SETTINGS" TRINA_STATE="$STATE" TRINA_PREFIX="$TOKEN_PREFIX"
  export TRINA_SETTINGS_OUT="$SETTINGS.trina-tmp.$$" TRINA_STATE_OUT="$STATE.trina-tmp.$$"
  export TRINA_HUB="$HUB" TRINA_MARKETPLACE="$MARKETPLACE" TRINA_PLUGIN="$PLUGIN" TRINA_MARKETPLACE_URL="$MARKETPLACE_URL"
  export TRINA_NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local old_token
  if ! TRINA_TOKEN="$TOKEN" TRINA_ENV="$ENV_JSON" TRINA_ENV_OWNED="$ENV_OWNED_JSON" json_op install; then
    revoke "$TOKEN"
    die "$(json_error_message)"
  fi
  old_token="$(head -n 1 "$WORK/result")"
  put_file "$SETTINGS" "$TRINA_SETTINGS_OUT"
  put_file "$STATE" "$TRINA_STATE_OUT"
  info "설정을 바꿨어요: $SETTINGS${BACKUP:+ (백업: $BACKUP)}"

  local mcp_ok=1
  claude_quiet mcp remove "$MCP_NAME" --scope user || true
  if claude_quiet mcp add --transport http "$MCP_NAME" --scope user "$MCP_URL" --header "Authorization: Bearer $TOKEN"; then
    info "회사 파일(MCP 서버 '$MCP_NAME')을 연결했어요."
  else
    mcp_ok=0
    warn "회사 파일(MCP) 등록에 실패했어요: $(claude_said)"
  fi

  # subscription: the person signs in to Claude Code themselves; find out whether they already have
  local logged_in=1
  if [ "$ACCESS_MODE" = subscription ] && ! claude_logged_in; then logged_in=0; fi

  local plugin_ok=0
  if [ "$SKILLS_READY" = true ]; then
    # Claude Code registers the marketplace from settings.json and downloads the plugin in one short session; then the
    # install is recorded. It can take minutes, so say so first and show progress (see sync_plugins).
    info "회사 스킬을 받는 중이에요. 최대 3분 걸려요."
    sync_plugins
    if [ "$SYNC_TIMED_OUT" = 1 ]; then
      # not an error: the connection is complete, and Claude Code installs the plugin from settings.json at its next start
      warn "3분 안에 끝나지 않아서 멈췄어요. 연결은 이미 끝났어요. 회사 스킬은 다음에 Claude Code를 켤 때 받아요."
    else
      info "회사 스킬 받기가 끝났어요 (${SYNC_SECONDS}초)."
      claude_quiet plugin install "$PLUGIN" --scope user || true
      if plugin_installed; then plugin_ok=1; info "회사 스킬(플러그인 $PLUGIN)을 설치했어요. 스킬이 바뀌면 자동으로 업데이트돼요."
      elif [ "$logged_in" = 0 ]; then info "회사 스킬은 로그인한 뒤 Claude Code를 처음 열 때 자동으로 설치돼요."
      else warn "회사 스킬을 아직 설치하지 못했어요. 다음에 Claude Code를 켤 때 다시 시도해요. ($(claude_said))"
      fi
    fi
  fi

  chmod 600 "$SETTINGS" 2>/dev/null || true
  if [ -n "$old_token" ]; then revoke "$old_token"; fi
  unset TRINA_TOKEN TRINA_ENV TRINA_ENV_OWNED

  say ''
  if [ -n "$MODEL_NOTICE" ]; then
    # connected, but Claude cannot answer yet (company key mode and the hub has no API key): not a success line, not a failure
    printf '%s! %s%s\n' "$YELLOW" "$MODEL_NOTICE" "$RESET"
  else
    say "✓ 연결을 마쳤어요."
  fi
  if [ "$ACCESS_MODE" = subscription ]; then
    say "  - 모델: AI 사용은 본인 Claude 구독으로 해요. 사용량만 회사 허브에 기록돼요."
  else
    say "  - 모델: Claude의 요청이 회사 허브를 거쳐요. AI 사용료는 회사 계정으로 나가요."
  fi
  if [ "$mcp_ok" = 1 ]; then say "  - 회사 파일: Claude가 mcp__${MCP_NAME}__* 도구로 회사 폴더를 읽고 써요."; fi
  if [ "$plugin_ok" = 1 ]; then say "  - 회사 스킬: /${PLUGIN%%@*}:<스킬 이름> 으로 쓸 수 있어요."; fi
  if [ -n "$NOTICES" ]; then printf '%s\n' "$NOTICES" | while IFS= read -r line; do [ -n "$line" ] && say "  ! $line"; done; fi
  say ''
  say "  되돌리기: curl -fsSL ${HUB_URL}/install.sh | bash -s -- --uninstall"
  if [ -n "$BACKUP" ]; then say "  원래 설정 파일: $BACKUP"; fi
  if ! command -v claude >/dev/null 2>&1; then say "  새 터미널을 열면 claude 명령을 쓸 수 있어요 ($CLAUDE_BIN)."; fi
  if [ -n "$MODEL_NOTICE" ]; then
    say ''
    say "  관리자가 키를 넣으면 이 PC에서 바로 쓸 수 있어요. 다시 설치하지 않아도 돼요."
  elif [ "$logged_in" = 0 ]; then
    # subscription mode, nobody signed in yet: say what happens when they start Claude (one sentence per line)
    say ''
    say '  ┌──────────────────────────────────────────────────────────'
    say '  │ ! 마지막으로 한 가지만 남았어요'
    printf '%s\n' "${LOGIN_HINT//. /.$'\n'}" | while IFS= read -r line; do if [ -n "$line" ]; then say "  │   $line"; fi; done
    say '  └──────────────────────────────────────────────────────────'
  else
    say "  이제 터미널에서 claude 를 실행해 보세요."
  fi
}

# ---------------------------------------------------------------------------------------------------------------
# uninstall

do_uninstall() {
  say "Trina AX: 이 PC의 회사 허브 연결을 해제해요."
  pick_json_engine
  find_claude
  if [ -n "$CLAUDE_BIN" ]; then
    # while the settings still carry the marketplace entry (and, in company-key mode, the relay token)
    claude_quiet plugin uninstall "$PLUGIN" --scope user || true
    claude_quiet plugin marketplace remove "$MARKETPLACE" --scope user || true
    claude_quiet mcp remove "$MCP_NAME" --scope user || true
    info "회사 스킬과 회사 파일(MCP) 연결을 지웠어요."
  else
    warn "claude 명령을 찾지 못해서 플러그인과 MCP 등록은 그대로예요."
  fi

  backup_settings
  export TRINA_SETTINGS="$SETTINGS" TRINA_STATE="$STATE" TRINA_PREFIX="$TOKEN_PREFIX" TRINA_HUB="$HUB_URL"
  export TRINA_SETTINGS_OUT="$SETTINGS.trina-tmp.$$" TRINA_MARKETPLACE="$MARKETPLACE" TRINA_PLUGIN="$PLUGIN"
  json_op uninstall || die "$(json_error_message)"
  local token changed
  { IFS= read -r token; IFS= read -r changed; } <"$WORK/result" || true
  if [ "$changed" = changed ]; then
    put_file "$SETTINGS" "$TRINA_SETTINGS_OUT"
    info "설정에서 Trina AX 항목을 지웠어요: $SETTINGS${BACKUP:+ (백업: $BACKUP)}"
  else
    [ -z "$BACKUP" ] || rm -f "$BACKUP"
    info "설정에 Trina AX 항목이 없어요."
  fi
  if [ -n "$token" ]; then revoke "$token"; info "허브에서 이 PC의 토큰을 지웠어요."; fi
  rm -f "$STATE"

  say ''
  say "✓ 연결을 해제했어요. Claude Code는 그대로 남아 있어요."
}

if [ "$MODE" = uninstall ]; then do_uninstall; else do_install; fi
