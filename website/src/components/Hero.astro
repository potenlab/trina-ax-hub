---
// Hero: what Trina AX is in one line, two captioned ways to start (hosted by Trina, or install it yourself), and the
// scripted demo of the real app right under it (Demo.astro). {from} in a caption is the cheapest plan in PLANS.
import type { Copy } from '../content/en'
import { PLANS, bookCall, usd } from '../site'
import Demo from './Demo.astro'
import Icon from './Icon.astro'
interface Props { t: Copy }
const { t } = Astro.props
const h = t.hero
const from = usd(PLANS[0].usd)
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container hero-copy">
    <a class="pill" href="#open-source"><span class="pill-dot" aria-hidden="true"></span>{h.pill}</a>
    <h1 id="hero-title">{h.title} <span class="accent-text">{h.accent}</span></h1>
    <p class="hero-sub">{h.sub}</p>
    <div class="hero-ctas hero-choices">
      <div class="hero-choice">
        <a class="btn btn-primary btn-lg" href={bookCall(t.lang)}>{h.primary}<Icon name="arrow" /></a>
        <span class="hero-choice-note">{h.primaryNote.replace('{from}', from)}</span>
      </div>
      <div class="hero-choice">
        <a class="btn btn-secondary btn-lg" href="#start-self">{h.secondary}</a>
        <span class="hero-choice-note">{h.secondaryNote}</span>
      </div>
    </div>
  </div>
  <Demo t={t} />
</section>
