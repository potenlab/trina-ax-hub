---
// How it works (A7): three steps and one note.
import type { Copy } from '../content/en'
import Lines from './Lines.astro'
import Icon from './Icon.astro'
interface Props { t: Copy }
const { t } = Astro.props
const h = t.how
---
<section class="section" id="how" aria-labelledby="how-title">
  <div class="container">
    <div class="section-head">
      <h2 id="how-title"><Lines text={h.title} /></h2>
    </div>
    <ol class="steps">
      {h.steps.map((s, i) => (
        <li class="step">
          <span class="step-num">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
    <p class="how-note"><Icon name="key" /><span>{h.note}</span></p>
  </div>
</section>
