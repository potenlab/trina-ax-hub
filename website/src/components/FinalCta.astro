---
// Final call to action: dark in both themes. The same two choices as the hero: a call, or start free (the self-install
// path in "Two ways to start").
import type { Copy } from '../content/en'
import { BROCHURES, bookCall } from '../site'
import Lines from './Lines.astro'
import Icon from './Icon.astro'
import Logo from './Logo.astro'
interface Props { t: Copy }
const { t } = Astro.props
const c = t.cta
---
<section class="section section-cta" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="cta-box zone-dark">
      <span class="cta-logo" aria-hidden="true"><Logo /></span>
      <h2 id="contact-title"><Lines text={c.title} /></h2>
      <p>{c.sub}</p>
      <div class="hero-ctas">
        <a class="btn btn-primary btn-lg" href={bookCall(t.lang)}>{c.primary}<Icon name="arrow" /></a>
        <a class="btn btn-secondary btn-lg" href="#start-self">{c.secondary}</a>
      </div>
      <p class="brochure-link"><a href={BROCHURES[t.lang].pdf} download>{t.lang === 'ko' ? '소개서 받기' : 'Download brochure'} <span>PDF</span></a></p>
    </div>
  </div>
</section>
