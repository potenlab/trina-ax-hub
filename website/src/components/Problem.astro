---
// Problem (A5): Claude on every desk, the company in none of them. The row of desks is decorative.
import type { Copy } from '../content/en'
import Lines from './Lines.astro'
import Icon from './Icon.astro'
interface Props { t: Copy }
const { t } = Astro.props
const p = t.problem
---
<section class="section" id="problem" aria-labelledby="problem-title">
  <div class="container problem">
    <div>
      <h2 id="problem-title"><Lines text={p.title} /></h2>
      <p>{p.body}</p>
    </div>
    <div class="desks" aria-hidden="true">
      {[0, 1, 2, 3, 4, 5].map(() => (
        <div class="desk"><span class="desk-screen"><Icon name="spark" /></span><span class="desk-slot"><Icon name="folder" /></span></div>
      ))}
    </div>
  </div>
</section>
