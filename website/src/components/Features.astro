---
// Features bento: six cards (files with permissions, file formats, team skills, schedules, external services, usage),
// each with a small made-up UI in the app's words. The UI is decorative (aria-hidden); the card text says it in words.
import type { Copy } from '../content/en'
import Lines from './Lines.astro'
import { softPath } from '../util'
import Icon from './Icon.astro'
interface Props { t: Copy }
const { t } = Astro.props
const f = t.features
// Card layout: wide cards put the text next to the UI on large screens.
const wide = new Set(['files', 'schedule', 'usage'])
// The loosely typed copy items (each card has its own `ui` shape) are read through `any` in this one place.
const items = f.items as any[]
---
<section class="section section-tint" id="features" aria-labelledby="features-title">
  <div class="container">
    <div class="section-head">
      <h2 id="features-title"><Lines text={f.title} /></h2>
    </div>
    <ul class="bento">
      {items.map((it) => (
        <li class={`bcard bcard-${it.id}${wide.has(it.id) ? ' bcard-wide' : ''}`}>
          <div class="bcard-text">
            <h3>{it.title}</h3>
            <p>{it.body}</p>
          </div>
          <div class="bcard-ui">
            {it.id === 'files' && (
              <div class="mini" aria-hidden="true">
                <p class="mini-head">{it.ui.head}</p>
                <div class="mt">
                  {it.ui.tree.map((r: any) => (
                    <div class={`mt-row mt-${r.kind}`}><Icon name={r.kind === 'folder' ? 'folder' : 'file'} /><span>{softPath(r.name)}</span></div>
                  ))}
                </div>
              </div>
            )}
            {it.id === 'formats' && (
              <div class="mini" aria-hidden="true">
                <p class="mini-head">{it.ui.head}</p>
                <ul class="ft">
                  {it.ui.types.map((x: string) => <li data-kr={String(x.startsWith('HWP'))}>{x}</li>)}
                </ul>
                <p class="mini-head ft-make">{it.ui.makeHead}</p>
                <ul class="ft">
                  {it.ui.makes.map((x: string) => <li data-make="true">{x}</li>)}
                </ul>
              </div>
            )}
            {it.id === 'skills' && (
              <div class="mini" aria-hidden="true">
                <p class="mini-head">{it.ui.head}</p>
                <div class="sk">
                  {it.ui.rows.map((r: any) => (
                    <div class="sk-row"><span class="sk-name"><Icon name="spark" /><span>{r.name}</span></span><span class="pill-s" data-fresh={String(r.fresh)}>{r.state}</span></div>
                  ))}
                </div>
              </div>
            )}
            {it.id === 'usage' && (
              <div class="mini" aria-hidden="true">
                <div class="mu-top"><p class="mini-head">{it.ui.head}</p><span class="mu-export"><Icon name="download" />{it.ui.export}</span></div>
                <div class="mu-rows">
                  {it.ui.rows.map((r: any, i: number) => (
                    <div class="mu-row" data-top={String(i === 0)}><span class="mu-name">{r.name}</span><span class="mu-track"><span class={`mu-bar w-${r.w}`}></span></span></div>
                  ))}
                </div>
                <p class="mu-limit">{it.ui.limit}</p>
              </div>
            )}
            {it.id === 'schedule' && (
              <div class="mini mini-sched" aria-hidden="true">
                <div>
                  <p class="mini-head">{it.ui.head}</p>
                  <div class="sk">
                    {it.ui.rows.map((r: any) => (
                      <div class="sk-row"><span class="sk-name"><Icon name="clock" /><span>{r.name}</span></span><span class="pill-s">{r.when}</span></div>
                    ))}
                  </div>
                  <p class="sched-next">{it.ui.next}</p>
                </div>
                <div class="phone phone-toast">
                  <div class="phone-notch"></div>
                  <p class="toast"><span class="cx-mark"><Icon name="bell" /></span><span>{it.ui.toast}</span></p>
                </div>
              </div>
            )}
            {it.id === 'connections' && (
              <div class="mini" aria-hidden="true">
                <p class="mini-head">{it.ui.head}</p>
                <div class="sk">
                  {it.ui.rows.map((r: any, i: number) => (
                    <div class="sk-row"><span class="sk-name"><Icon name="plug" /><span>{r.name}</span><small class="conn-kind">{r.kind}</small></span><span class="pill-s" data-fresh={String(i === 2)}>{r.state}</span></div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
