---
import type { Copy } from '../content/en'
import { COMPANY, CONTACT_EMAIL, LEGAL, LINKS, ROUTES } from '../site'
import Logo from './Logo.astro'

interface Props { t: Copy }
const { t } = Astro.props
const f = t.footer
const l = f.links
const home = ROUTES.home[t.lang]
const lang = t.lang
// the business details Korean e-commerce law asks for, in trina.app's order
const biz: [string, string][] = [
  [f.biz.ceo, COMPANY.ceo[lang]],
  [f.biz.bizNo, COMPANY.bizNo],
  [f.biz.address, COMPANY.address[lang]],
  [f.biz.phone, COMPANY.phone[lang]],
  [f.biz.hosting, COMPANY.hosting],
]
---
<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a class="logo" href={home} aria-label={t.nav.home}><Logo /><span>{t.brand}</span></a>
        <p class="footer-company">{f.company}</p>
        <a class="footer-mail" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </div>
      <nav class="footer-links" aria-label="Footer">
        <a href={LINKS.company} rel="noopener">{l.company}</a>
        <a href={LINKS.github} rel="noopener">{l.github}</a>
        <a href={ROUTES.security[t.lang]}>{l.security}</a>
        <a href={LEGAL.terms.path} hreflang="en">{l.terms}</a>
        <a href={LEGAL.privacy.path} hreflang="en">{l.privacy}</a>
        <a href={LEGAL.refund.path} hreflang="en">{l.refund}</a>
      </nav>
    </div>
    <p class="footer-biz">
      {biz.map(([label, value]) => <span class="footer-biz-item"><span class="footer-biz-label">{label}</span> {value}</span>)}
    </p>
    <p class="footer-trademark">{f.trademark}</p>
  </div>
</footer>
