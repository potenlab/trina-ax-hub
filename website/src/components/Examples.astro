---
// Examples by role (A12): four cards, each with the role, what they ask and what comes back.
import type { Copy } from '../content/en'
import Lines from './Lines.astro'
import Icon from './Icon.astro'
interface Props { t: Copy }
const { t } = Astro.props
const e = t.examples
---
<section class="section" id="examples" aria-labelledby="examples-title">
  <div class="container">
    <div class="section-head">
      <h2 id="examples-title"><Lines text={e.title} /></h2>
    </div>
    <ul class="examples">
      {e.items.map((x) => (
        <li class="ex">
          <span class="ex-role">{x.role}</span>
          <div><span class="ex-label">{e.asks}</span><p class="ex-q">{x.q}</p></div>
          <div><span class="ex-label">{e.gets}</span><p class="ex-a"><Icon name="check" /><span>{x.a}</span></p></div>
        </li>
      ))}
    </ul>
    <p class="examples-note">{e.note}</p>
  </div>
</section>
