---
// Works-with band (A3): the Claude surfaces it connects to, as plain text chips (no logos: Claude is Anthropic's
// trademark), and the trademark / non-affiliation line.
import type { Copy } from '../content/en'
import Icon from './Icon.astro'
interface Props { t: Copy }
const { t } = Astro.props
const w = t.works
const icons = ['monitor', 'globe', 'phone', 'server', 'spark']
---
<section class="works" aria-labelledby="works-title">
  <div class="container">
    <h2 id="works-title">{w.title}</h2>
    <ul class="works-list">
      {w.items.map((x, i) => <li><Icon name={icons[i] ?? 'spark'} />{x}</li>)}
    </ul>
    <p class="works-note">{w.note}</p>
  </div>
</section>
