---
// Two ways to start, side by side and equal: hosted by Trina, or installed yourself (three steps each, a caption that
// says who does the work, and one button). Then the first week as a checklist, linked to the guide page.
// Replaces the old "Set up once" steps and the "Not a one-off install" block.
import type { Copy } from '../content/en'
import { LINKS, PLANS, ROUTES, bookCall, priceWithReference } from '../site'
import Lines from './Lines.astro'
import Icon from './Icon.astro'
interface Props { t: Copy }
const { t } = Astro.props
const s = t.start
const from = priceWithReference(PLANS[0].usd, t.lang)
---
<section class="section" id="start" aria-labelledby="start-title">
  <div class="container">
    <div class="section-head">
      <h2 id="start-title"><Lines text={s.title} /></h2>
      <p>{s.body}</p>
    </div>
    <div class="paths">
      {s.paths.map((p) => (
        <div class={`path-card path-${p.id}`} id={`start-${p.id}`}>
          <div class="path-head">
            <span class="icon-chip"><Icon name={p.id === 'hosted' ? 'cloud' : 'server'} /></span>
            <div>
              <h3>{p.name}</h3>
              <p class="path-price">{p.price.replace('{from}', from)}</p>
            </div>
          </div>
          <p class="path-caption">{p.caption}</p>
          <ol class="path-steps">
            {p.steps.map((st, i) => (
              <li><span class="step-num" aria-hidden="true">{i + 1}</span><div><h4>{st.title}</h4><p>{st.body}</p></div></li>
            ))}
          </ol>
          {p.id === 'hosted' ? (
            <a class="btn btn-primary path-cta" href={bookCall(t.lang)}>{p.cta}<Icon name="arrow" /></a>
          ) : (
            <a class="btn btn-secondary path-cta" href={LINKS.install[t.lang]} rel="noopener"><Icon name="github" />{p.cta}</a>
          )}
        </div>
      ))}
    </div>
    <div class="week">
      <h3 class="week-title"><Icon name="calendar" />{s.week.title}</h3>
      <ol class="week-list">
        {s.week.items.map((w) => (
          <li><span class="week-check" aria-hidden="true"><Icon name="check" /></span><div><p class="week-item">{w.title}<span class="week-who">{w.who}</span></p><p class="week-body">{w.body}</p></div></li>
        ))}
      </ol>
      <a class="week-link" href={ROUTES.firstWeek[t.lang]}>{s.week.link}<Icon name="arrow" /></a>
    </div>
  </div>
</section>
