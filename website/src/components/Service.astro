---
// Service (A13): not a one-off install.
import type { Copy } from '../content/en'
import Lines from './Lines.astro'
interface Props { t: Copy }
const { t } = Astro.props
const s = t.service
---
<section class="section section-tint" id="service" aria-labelledby="service-title">
  <div class="container service">
    <div class="section-head">
      <h2 id="service-title"><Lines text={s.title} /></h2>
      <p>{s.body}</p>
    </div>
    <ol class="path" aria-hidden="true">
      {s.path.map((x) => <li>{x}</li>)}
    </ol>
  </div>
</section>
