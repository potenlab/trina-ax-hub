---
// Pricing: self-host versus Trina hosting as a two-column comparison, then the hosting plans (numbers from FREE_PLAN and
// PLANS in src/site.ts; the Free card is muted, not featured, words from the copy), what every plan includes, the billing terms the resellers ask us to show, and
// three small blocks. The table keeps its semantics (explicit roles) because on phones its rows become stacked cards.
import type { Copy } from '../content/en'
import { FREE_PLAN, LEGAL, LINKS, PLANS, bookCall, usd, priceWithReference, krwNote, KRW_REFERENCE, quoteRequest, CONTACT_EMAIL } from '../site'
import Lines from './Lines.astro'
interface Props { t: Copy }
const { t } = Astro.props
const p = t.pricing
const from = priceWithReference(PLANS[0].usd, t.lang)
const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(v[k]))
const book = bookCall(t.lang)
---
<section class="section section-tint" id="pricing" aria-labelledby="pricing-title">
  <div class="container">
    <div class="section-head">
      <h2 id="pricing-title"><Lines text={fill(p.title, { from: usd(PLANS[0].usd) })} /></h2>
    </div>
    <div class="cmp-wrap">
      <table class="cmp" role="table">
        <thead role="rowgroup">
          <tr role="row">
            <th class="cmp-corner" scope="col" role="columnheader">{p.corner}</th>
            <th scope="col" role="columnheader">{p.cols[0]}</th>
            <th scope="col" role="columnheader" class="cmp-hosted">{p.cols[1]}</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {p.rows.map((r) => (
            <tr role="row">
              <th scope="row" role="rowheader">{r.label}</th>
              <td role="cell" data-label={p.cols[0]}>{r.a}</td>
              <td role="cell" data-label={p.cols[1]} class="cmp-hosted">{fill(r.b, { from })}</td>
            </tr>
          ))}
          <tr role="row">
            <th scope="row" role="rowheader">{p.startLabel}</th>
            <td role="cell" data-label={p.cols[0]}><a class="btn btn-secondary btn-sm" href={LINKS.install[t.lang]} rel="noopener">{p.startA}</a></td>
            <td role="cell" data-label={p.cols[1]} class="cmp-hosted"><a class="btn btn-primary btn-sm" href="#plans">{p.startB}</a></td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="plans-title" id="plans">{p.plansTitle}</h3>
    <ul class="plans">
      <li class="plan plan-free" data-plan="free">
        <h4 class="plan-name">{p.free.name}</h4>
        <p class="plan-price"><span class="plan-amount">{usd(FREE_PLAN.usd)}</span> <span class="plan-per">{p.perMonth}</span></p>
        <p class="plan-reference">{p.free.card}</p>
        <p class="plan-people">{fill(p.people, { n: FREE_PLAN.people })}</p>
        <p class="plan-server">{p.free.teams} · {fill(p.free.running, { n: FREE_PLAN.running })}<br />{fill(p.free.server, { cpu: FREE_PLAN.vcpu, mem: FREE_PLAN.memoryGb, disk: FREE_PLAN.storageGb })}</p>
        <a class="btn btn-secondary btn-sm plan-cta" href={LINKS.signup} rel="noopener">{p.free.cta}</a>
      </li>
      {PLANS.map((plan) => (
        <li class="plan" data-plan={plan.id}>
          <h4 class="plan-name">{p.plans[plan.id]}</h4>
          <p class="plan-price"><span class="plan-amount">{usd(plan.usd)}</span> <span class="plan-per">{p.perMonth}</span></p>
          <p class="plan-reference">{krwNote(plan.usd, t.lang)}</p>
          <p class="plan-people">{fill(p.people, { n: plan.people })}</p>
          <p class="plan-server">{fill(p.server, { cpu: plan.vcpu, mem: plan.memoryGb, disk: plan.storageGb })}</p>
          <a class="btn btn-primary btn-sm plan-cta" href={book}>{p.planCta}</a>
        </li>
      ))}
      <li class="plan plan-custom" data-plan="custom">
        <h4 class="plan-name">{p.custom.name}</h4>
        <p class="plan-price"><span class="plan-amount">{p.custom.price}</span></p>
        <p class="plan-people">{p.custom.people}</p>
        <p class="plan-server">{p.custom.body}</p>
        <a class="btn btn-secondary btn-sm plan-cta" href={book}>{p.custom.cta}</a>
      </li>
    </ul>
    <p class="plans-fine plans-free-note">{p.free.note}</p>
    <p class="plans-fine krw-reference">{t.lang === 'ko'
      ? `${KRW_REFERENCE.date} 환율 기준 · 천 원 단위 반올림. 원화는 참고 금액이고 실제 결제는 달러 기준이에요.`
      : `Reference rate dated ${KRW_REFERENCE.date}, rounded to the nearest thousand won. KRW amounts are estimates; billing is in USD.`}
      <a href={KRW_REFERENCE.source} rel="noopener">{KRW_REFERENCE.provider}</a>
    </p>
    <div class="quote-request">
      <a class="btn btn-secondary" href={quoteRequest(t.lang)}>{t.lang === 'ko' ? '견적서 받기' : 'Request a quote'}</a>
      <p>{t.lang === 'ko' ? '원화 계약과 세금계산서 발행은 요청하시면 안내해 드려요. 메일 앱이 열리지 않으면 아래 주소로 보내 주세요.' : 'KRW contracts and Korean tax invoices are available on request. If your mail app does not open, email the address below.'}<br /><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
    </div>
    <p class="plans-included">{p.included}</p>
    <p class="plans-fine">
      {p.fine}
      <a href={LEGAL.terms.path}>{p.termsLink}</a> · <a href={LEGAL.refund.path}>{p.refundLink}</a>
    </p>

    <div class="cmp-blocks">
      {p.blocks.map((b) => (
        <div class="cmp-block"><h3>{b.title}</h3><p>{b.body}</p></div>
      ))}
    </div>
  </div>
</section>
