---
// Role tabs (CEO / Sales / Finance / People): one real piece of office work each: what the person asks, what the AI
// used (schedule, folders, team skill, where it saved) and a small preview of what comes back (a weekly report, a
// quote, a tidied spreadsheet, a reply to an official letter). Tabs follow the ARIA tabs pattern and never advance on
// their own (src/scripts/tabs.ts); without JavaScript the tab row is hidden and the four panels are simply listed.
import type { Copy } from '../content/en'
import { ROUTES } from '../site'
import { softPath } from '../util'
import Lines from './Lines.astro'
import Icon from './Icon.astro'
interface Props { t: Copy }
const { t } = Astro.props
const r = t.roles
const items = r.items as any[]
const kindIcon: Record<string, string> = { schedule: 'clock', folder: 'folder', skill: 'spark', save: 'download', file: 'file' }
const docIcon: Record<string, string> = { doc: 'doc', sheet: 'sheet', letter: 'doc' }
---
<section class="section" id="roles" aria-labelledby="roles-title">
  <div class="container">
    <div class="section-head">
      <h2 id="roles-title"><Lines text={r.title} /></h2>
      <p>{r.body}</p>
    </div>
    <div class="roles" data-tabs>
      <div class="roles-tabs" role="tablist" aria-label={r.tabsLabel}>
        {items.map((it, i) => (
          <button class="roles-tab" type="button" role="tab" id={`role-tab-${it.id}`} aria-controls={`role-${it.id}`} aria-selected={String(i === 0)} tabindex={i === 0 ? '0' : '-1'}>{it.role}</button>
        ))}
      </div>
      {items.map((it, i) => (
        <div class={`role${i === 0 ? ' is-active' : ''}`} id={`role-${it.id}`} role="tabpanel" aria-labelledby={`role-tab-${it.id}`} tabindex="0">
          <div class="role-left">
            <p class="role-who"><span class="av">{it.who.slice(0, 1)}</span><span>{it.who}<small>{it.role}</small></span></p>
            <span class="ex-label">{r.asks}</span>
            <p class="msg-q role-q">{it.q}</p>
            <span class="ex-label">{r.used}</span>
            <ul class="role-used">
              {it.used.map((u: any) => <li data-kind={u.kind}><Icon name={kindIcon[u.kind] ?? 'file'} /><span>{softPath(u.text)}</span></li>)}
            </ul>
            <p class="role-scope"><Icon name="lock" />{r.scope.replace('{name}', it.who)}</p>
          </div>
          <div class="role-right">
            <span class="ex-label">{r.result}</span>
            <div class={`rdoc rdoc-${it.doc.kind}`}>
              <p class="rdoc-file"><Icon name={docIcon[it.doc.kind] ?? 'doc'} /><span>{it.doc.file}</span></p>
              <div class="rdoc-page">
                <p class="rdoc-title">{it.doc.title}</p>
                {it.doc.kind === 'doc' && it.doc.blocks.map((b: any) => (
                  <div class="rdoc-block"><p class="rdoc-h">{b.h}</p><p>{b.p}</p></div>
                ))}
                {it.doc.kind === 'sheet' && (
                  <>
                    <table class="rdoc-grid">
                      <thead><tr>{it.doc.cols.map((c: string) => <th>{c}</th>)}</tr></thead>
                      <tbody>{it.doc.rows.map((row: string[]) => <tr>{row.map((c, j) => <td class={j > 0 && /^\d/.test(c) ? 'num' : undefined}>{c}</td>)}</tr>)}</tbody>
                    </table>
                    <p class="rdoc-foot">{it.doc.foot}</p>
                  </>
                )}
                {it.doc.kind === 'letter' && (
                  <div class="rdoc-letter">{it.doc.lines.map((l: string) => <p>{l}</p>)}</div>
                )}
              </div>
              {it.doc.toast && <p class="rdoc-toast"><Icon name="bell" /><span>{it.doc.toast}</span></p>}
            </div>
          </div>
          <div class="role-more">
            <span class="ex-label">{r.moreTitle}</span>
            <ul>{it.more.map((m: string) => <li>{m}</li>)}</ul>
          </div>
        </div>
      ))}
    </div>
    <p class="roles-foot"><span>{r.note}</span><a href={ROUTES.guide[t.lang] + '#use-cases'}>{r.link}<Icon name="arrow" /></a></p>
  </div>
</section>
