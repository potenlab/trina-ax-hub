---
// Keep #roles for existing nav and guide links. Every example is server-rendered;
// scroll effects only emphasize visible cards, never gate the content.
import type { Copy } from '../content/en'
import { teamCopy } from '../content/teams'
import { guidePath } from '../content/guides'
import { softPath } from '../util'
import Icon from './Icon.astro'
import '../styles/teams.css'
interface Props { t: Copy }
const { t } = Astro.props
const copy = teamCopy[t.lang]
---
<section class="section team-showcase" id="roles" aria-labelledby="roles-title" data-team-showcase>
  <div class="container">
    <div class="section-head team-intro">
      <h2 id="roles-title">{copy.title}</h2>
      <p>{copy.body}</p>
    </div>
    <p class="team-scope"><Icon name="lock" />{copy.scope}</p>
    <p class="team-note">{copy.note}</p>
    <div class="team-controls">
      <nav class="team-jumps" aria-label={copy.jump}>
        {copy.teams.map(team => <a href={`#team-${team.id}`}>{team.name}</a>)}
      </nav>
      <button class="team-motion" type="button" data-team-motion aria-pressed="false" hidden>
        <Icon name="pause" /><span>{copy.motion}</span>
      </button>
    </div>
    <div class="team-chapters">
      {copy.teams.map(team => (
        <section class="team-chapter" id={`team-${team.id}`} aria-labelledby={`team-${team.id}-title`}>
          <header class="team-heading">
            <div><h3 id={`team-${team.id}-title`} tabindex="-1">{team.name}</h3><p>{team.role}</p></div>
            <a class="team-more" href={guidePath(team.guide, t.lang)}>{copy.more}<span class="sr-only"> · {team.name}</span><Icon name="arrow" /></a>
          </header>
          <div class="team-examples">
            {team.examples.map((example, index) => (
              <article class="team-example" aria-labelledby={`${team.id}-request-${index}`}>
                <div class="team-request">
                  <div class="team-person"><span class="team-avatar" aria-hidden="true">{example.person.slice(0, 1)}</span><span>{example.person}</span><span class="team-example-label">{copy.label}</span></div>
                  <h4 id={`${team.id}-request-${index}`}>{example.request}</h4>
                  <ul class="team-inputs">
                    <li class="team-skill"><Icon name="spark" /><span>{copy.skill} · {example.skill}</span></li>
                    {example.sources.map(source => <li class="team-source"><Icon name="folder" /><span>{copy.source} · {softPath(source)}</span></li>)}
                    {example.tool && <li class="team-tool"><Icon name={example.tool.kind} /><span>{example.tool.text}</span></li>}
                  </ul>
                </div>
                <div class="team-response">
                  <p class="team-answer">{example.answer}</p>
                  <figure class="team-result">
                    <figcaption><span>{copy.result}</span><span aria-hidden="true">↳</span></figcaption>
                    {example.preview.kind === 'file' && (
                      <div class="team-document">
                        <p class="team-file"><span>{example.preview.file.split('.').pop()?.toUpperCase()}</span><strong>{softPath(example.preview.file)}</strong></p>
                        <p class="team-document-title">{example.preview.title}</p>
                        <ul>{example.preview.lines.map(line => <li>{line}</li>)}</ul>
                      </div>
                    )}
                    {example.preview.kind === 'table' && (
                      <div class="team-table">
                        <table>
                          <caption>{softPath(example.preview.title)}</caption>
                          <thead><tr>{example.preview.columns.map(column => <th scope="col">{column}</th>)}</tr></thead>
                          <tbody>{example.preview.rows.map(row => <tr>{row.map(cell => <td>{cell}</td>)}</tr>)}</tbody>
                        </table>
                        {example.preview.foot && <p>{example.preview.foot}</p>}
                      </div>
                    )}
                    {example.preview.kind === 'number' && (
                      <div class="team-number"><p>{example.preview.title}</p><strong>{example.preview.value}</strong><small>{example.preview.detail}</small></div>
                    )}
                  </figure>
                  {example.confirmation && <aside class="team-confirm" aria-label={example.confirmation.title}>
                    <p><Icon name="shield" /><strong>{example.confirmation.title}</strong></p>
                    <p>{example.confirmation.body}</p><small>{example.confirmation.status}</small>
                  </aside>}
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</section>
<script>
  import '../scripts/teams'
</script>
