# Response headers for Cloudflare Workers Assets (wrangler.toml, [assets]). Everything is first-party: no third-party
# script, style, font, image, frame or connection is allowed. Astro is configured to emit every script and stylesheet as
# a file (astro.config.mjs), and the markup uses no inline style attributes. The one inline <script> per page is JSON-LD
# (type="application/ld+json"), which is data and is never executed. If you add analytics or a widget, add its origin
# here or the browser will block it.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; manifest-src 'self'; media-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=2592000

/theme.js
  Cache-Control: public, max-age=3600

/og.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og-ko.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/llms.txt
  Content-Type: text/plain; charset=utf-8
